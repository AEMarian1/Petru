# Copiați în .env.local și completați local. Fără valori reale în depozit.

# Mediul: local | previzualizare | test | productie
PETRU_MEDIU=local

# Numele instituției afișat în antet (setare, nu cod). În producție vine din baza de date.
PETRU_INSTITUTIE="Primăria Comunei Exemplu"

# Baza de date (de la pasul S2). Valoarea reală stă numai în setările Netlify / Azure Key Vault.
DATABASE_URL=postgres://utilizator:parola-inventata@localhost:5432/petru
