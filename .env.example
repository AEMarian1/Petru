# Copiați în .env.local și completați local. Fără valori reale în depozit.

# Mediul: local | previzualizare | test | productie
PETRU_MEDIU=local

# Numele instituției afișat în antet (setare, nu cod). În producție vine din baza de date.
PETRU_INSTITUTIE="Primăria Comunei Exemplu"

# Baza de date. Local: docker compose up -d. Valorile pentru Neon și Azure stau numai în setările lor, niciodată aici.
DATABASE_URL=postgres://petru:petru-local@localhost:5432/petru

# Opțional: conexiunea directă (fără pooler), folosită la refacerea bazei de probă.
# DATABASE_URL_DIRECTA=

# Semnarea sesiunilor: un șir aleator de cel puțin 32 de caractere (în producție obligatoriu).
# AUTH_SECRET=

# Intrarea cu Entra ID (producție). Fără ele, intrarea Entra e ascunsă.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# Adresa publică a aplicației, pentru întoarcerea de la Entra ID.
# PETRU_URL=https://petru.exemplu.invalid
